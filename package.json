{
  "name": "@flownex-ai/mcp-gpt-image-2",
  "version": "0.1.6",
  "description": "MCP server for OpenAI's gpt-image-2 image generation with size/quality control, multi-image support, and context-window-safe output",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-gpt-image-2": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    ".claude-plugin/",
    ".mcp.json",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "release": "./scripts/release.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.12",
    "openai": "^4.79.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowNex-AI/gpt-image-2-mcp.git"
  },
  "keywords": [
    "mcp",
    "openai",
    "gpt-image-2",
    "image-generation",
    "claude-code"
  ],
  "license": "MIT",
  "author": {
    "name": "FlowNex AI",
    "url": "https://flownexai.com"
  }
}
